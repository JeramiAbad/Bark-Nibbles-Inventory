@model Barks.Models.ViewModels.AdminPasswordResetViewModel
@{
    Layout = null;
    ViewData["Title"] = "Reset admin password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f8f5" />
    <title>@ViewData["Title"] | Bark Nibbles Inventory</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="account-page">
    <main class="account-card">
        <a class="account-brand" asp-controller="Home" asp-action="Index">
            <img src="~/images/bark-nibbles-logo.jpg" alt="" />
            <span>bark <strong>nibbles</strong><small>INVENTORY ROOM</small></span>
        </a>
        <p class="eyebrow">Account recovery</p>
        <h1>Reset your password</h1>
        <p class="account-description">Enter your admin username and choose a new password of at least 12 characters. For security, password resets are only available on the host PC.</p>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <form asp-action="ForgotPassword" method="post" class="account-form">
            <div class="form-field">
                <label asp-for="Username"></label>
                <input asp-for="Username" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <button class="button button-primary account-submit" type="submit">Reset password</button>
        </form>
        <p class="account-recovery-link"><a asp-action="Login">Back to sign in</a></p>
        <p class="account-note">Open this page at http://localhost:5128 on the computer running the inventory. It cannot reset a password from another device.</p>
    </main>
</body>
</html>
