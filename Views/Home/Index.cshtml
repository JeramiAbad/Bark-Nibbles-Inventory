@model Barks.Models.ViewModels.InventoryDashboardViewModel

@{
    ViewData["Title"] = "Inventory overview";
}

<div class="page-heading dashboard-heading">
    <div>
        <p class="eyebrow">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
        <h1>Inventory overview</h1>
        <p class="page-subtitle">A fresh look at the treats on your shelves.</p>
    </div>
    <div class="heading-actions">
        <a class="button button-secondary" asp-controller="Transactions" asp-action="Create" asp-route-transactionType="Stock Out">↑ &nbsp; Stock out</a>
        <a class="button button-primary" asp-controller="Transactions" asp-action="Create">＋ &nbsp; Record stock</a>
    </div>
</div>

<section class="metric-grid" aria-label="Inventory summary">
    <article class="metric-card">
        <div class="metric-top"><span class="metric-label">Products</span><span class="metric-icon metric-icon-peach">▤</span></div>
        <strong class="metric-value">@Model.ProductCount</strong>
        <a asp-controller="Products" asp-action="Index" class="metric-foot">View product list <span>↗</span></a>
    </article>
    <article class="metric-card">
        <div class="metric-top"><span class="metric-label">Units on hand</span><span class="metric-icon metric-icon-sage">▦</span></div>
        <strong class="metric-value">@Model.UnitsOnHand.ToString("N0")</strong>
        <span class="metric-foot">Across all products</span>
    </article>
    <article class="metric-card">
        <div class="metric-top"><span class="metric-label">Inventory value</span><span class="metric-icon metric-icon-lilac">＄</span></div>
        <strong class="metric-value">@Model.InventoryValue.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"))</strong>
        <span class="metric-foot">Based on product prices</span>
    </article>
    <article class="metric-card metric-card-alert">
        <div class="metric-top"><span class="metric-label">Needs a restock</span><span class="metric-icon metric-icon-alert">!</span></div>
        <strong class="metric-value">@Model.LowStockCount</strong>
        <a asp-controller="Products" asp-action="Index" asp-route-lowStock="true" class="metric-foot">Products at minimum stock <span>↗</span></a>
    </article>
</section>

<div class="dashboard-columns">
    <section class="panel inventory-panel" aria-labelledby="restock-title">
        <div class="panel-heading">
            <div><p class="panel-kicker">Keep the shelves happy</p><h2 id="restock-title">Low stock watch</h2></div>
            <a class="panel-link" asp-controller="Products" asp-action="Index" asp-route-lowStock="true">See all <span>↗</span></a>
        </div>
        @if (Model.LowStockProducts.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon">✓</span>
                <strong>All stocked up!</strong>
                <p>Every product is above its minimum stock level.</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead><tr><th>Product</th><th>Category</th><th>In stock</th><th>Minimum</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var product in Model.LowStockProducts)
                        {
                            <tr>
                                <td><span class="product-name">@product.ProductName</span><span class="cell-subtitle">@(string.IsNullOrWhiteSpace(product.ItemCode) ? product.Supplier : product.ItemCode)</span></td>
                                <td>@(string.IsNullOrWhiteSpace(product.Category) ? "—" : product.Category)</td>
                                <td><strong class="quantity-low">@product.Quantity</strong></td>
                                <td>@(product.MinimumStock == 0 ? "—" : product.MinimumStock)</td>
                                <td><span class="status-pill status-low">Restock</span></td>
                                <td><a class="row-action" asp-controller="Transactions" asp-action="Create" asp-route-productId="@product.ProductId">+ Add</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel activity-panel" aria-labelledby="activity-title">
        <div class="panel-heading">
            <div><p class="panel-kicker">The latest comings &amp; goings</p><h2 id="activity-title">Recent activity</h2></div>
            <a class="panel-link" asp-controller="Transactions" asp-action="Index">History <span>↗</span></a>
        </div>
        @if (Model.RecentTransactions.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon">↔</span>
                <strong>No stock movements yet</strong>
                <p>Record a stock-in or stock-out to start your activity history.</p>
                <a class="button button-primary button-small" asp-controller="Transactions" asp-action="Create">Record movement</a>
            </div>
        }
        else
        {
            <div class="activity-list">
                @foreach (var transaction in Model.RecentTransactions)
                {
                    var isStockIn = transaction.TransactionType == "Stock In";
                    <article class="activity-item">
                        <span class="activity-icon @(isStockIn ? "activity-in" : "activity-out")">@(isStockIn ? "↓" : "↑")</span>
                        <div class="activity-detail">
                            <strong>@(transaction.Product?.ProductName ?? "Product")</strong>
                            <span>@transaction.TransactionType · @transaction.Date.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                        </div>
                        <strong class="activity-quantity @(isStockIn ? "quantity-positive" : "quantity-negative")">@(isStockIn ? "+" : "−")@transaction.Quantity</strong>
                    </article>
                }
            </div>
        }
    </section>
</div>

<section class="dashboard-banner">
    <div class="banner-mark">bn<span>✳</span></div>
    <div><strong>Small-batch treats, big-time organized.</strong><span>Keep every Bark Nibbles favourite in stock and ready to make tails wag.</span></div>
    <a asp-controller="Products" asp-action="Create">Add a product <span>↗</span></a>
</section>
