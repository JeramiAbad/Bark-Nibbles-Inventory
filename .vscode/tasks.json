{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start Bark Nibbles Inventory",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/Bark-Nibbles-Inventory.csproj",
                "--launch-profile",
                "http"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "^\\s*Now listening on:\\s+http://.*:5128"
                }
            }
        }
    ]
}
